{
  "uid": "overload-recovery",
  "title": "Overload and recovery",
  "description": "Stage 4: does the backlog grow and drain, and what fails meanwhile. Stage 5: where API latency comes from (bottom row). See docs/resilience/scenarios.md and docs/performance/01-after-stage-4.md.",
  "tags": ["event-platform"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events/s: accepted by the API vs aggregated by the processor",
      "description": "A gap where accepted > aggregated means the backlog grows; aggregated > accepted means it drains.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ingestion_events_accepted_total[$__rate_interval]))", "legendFormat": "accepted" },
        { "refId": "B", "expr": "sum(rate(processor_events_aggregated_total[$__rate_interval]))", "legendFormat": "aggregated" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer lag (events): total and per partition",
      "description": "From kafka-exporter (committed offsets), so it keeps reporting while the processor is down. A partition without a committed offset (exporter value -1) shows the events it already holds, not -1.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(clamp_min(kafka_consumergroup_lag{consumergroup=\"event-processor\",topic=\"events.v1\"}, 0)) + (sum((kafka_topic_partition_current_offset{topic=\"events.v1\"} - kafka_topic_partition_oldest_offset{topic=\"events.v1\"}) and on(topic, partition) (kafka_consumergroup_current_offset{consumergroup=\"event-processor\",topic=\"events.v1\"} == -1)) or vector(0))", "legendFormat": "total" },
        { "refId": "B", "expr": "kafka_consumergroup_lag{consumergroup=\"event-processor\",topic=\"events.v1\"} >= 0 or on(topic, partition) ((kafka_topic_partition_current_offset{topic=\"events.v1\"} - kafka_topic_partition_oldest_offset{topic=\"events.v1\"}) and on(topic, partition) (kafka_consumergroup_current_offset{consumergroup=\"event-processor\",topic=\"events.v1\"} == -1))", "legendFormat": "p{{partition}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rejected and failed requests/s (POST /v1/events, not 202)",
      "description": "4xx (including 429) are rejected; 5xx are ambiguous for the client.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"ingestion-api\",uri=\"/v1/events\",status!=\"202\"}[$__rate_interval]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duplicates skipped and records dead-lettered (per s)",
      "description": "Duplicates appear after redelivery (processor crash). Dead letters should stay at 0 in every scenario.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(processor_events_duplicate_total[$__rate_interval]))", "legendFormat": "duplicates" },
        { "refId": "B", "expr": "sum by (reason) (rate(processor_events_dead_lettered_total[$__rate_interval]))", "legendFormat": "dead-lettered {{reason}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed processing attempts/s, by class",
      "description": "processor_delivery_failures_total. transient = database unavailable, retried without limit.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (class) (rate(processor_delivery_failures_total[$__rate_interval]))", "legendFormat": "{{class}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Availability (1 = up)",
      "description": "pg_up from postgres-exporter; up = Prometheus could scrape the service.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1.1, "custom": { "lineInterpolation": "stepAfter" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max(pg_up)", "legendFormat": "PostgreSQL" },
        { "refId": "B", "expr": "max(up{job=\"event-processor\"})", "legendFormat": "event-processor" },
        { "refId": "C", "expr": "max(up{job=\"ingestion-api\"})", "legendFormat": "ingestion-api" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API p99 latency (202 responses) and longest GC pause",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ingestion-api\",uri=\"/v1/events\",status=\"202\"}[$__rate_interval])))", "legendFormat": "p99" },
        { "refId": "B", "expr": "max by (application) (jvm_gc_pause_seconds_max{application=~\"ingestion-api|event-processor\"})", "legendFormat": "GC pause max {{application}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU (0..1 of all cores): host and the two JVMs",
      "description": "host = the whole machine, including the Docker VM (Kafka, PostgreSQL, Valkey, k6). Per-container CPU is not in Prometheus: use docker stats (load-tests/run.sh with DOCKER_STATS=1).",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{application=~\"ingestion-api|event-processor\"}", "legendFormat": "{{application}}" },
        { "refId": "B", "expr": "max(system_cpu_usage{application=\"ingestion-api\"})", "legendFormat": "host" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Processor connection pool",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"event-processor\"})", "legendFormat": "active" },
        { "refId": "B", "expr": "sum(hikaricp_connections_pending{application=\"event-processor\"})", "legendFormat": "pending (waiting threads)" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Valkey rate-limit calls: p99 by outcome, and fallback active",
      "description": "ratelimit_valkey_duration_seconds. timeout = over rate-limit.timeout (100 ms); breaker_open = no call made, limited per instance. Fallback active (right axis) is 1 while the circuit breaker is not closed.",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fallback active" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "max", "value": 1.1 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineInterpolation", "value": "stepAfter" }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(ratelimit_valkey_duration_seconds_bucket{application=\"ingestion-api\"}[$__rate_interval])))", "legendFormat": "p99 {{outcome}}" },
        { "refId": "B", "expr": "max(ratelimit_fallback_active{application=\"ingestion-api\"})", "legendFormat": "fallback active" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka publish: p99 per batch, producer queue time and broker request latency (max)",
      "description": "Queue time = a record waiting in the producer for a free in-flight request; request latency = broker round trip (acks=all). The producer's max values cover its 30 s metrics window, so they trail.",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(ingestion_publish_duration_seconds_bucket{application=\"ingestion-api\"}[$__rate_interval])))", "legendFormat": "publish p99 (batch)" },
        { "refId": "B", "expr": "max(kafka_producer_record_queue_time_max{application=\"ingestion-api\"}) / 1000", "legendFormat": "record queue time max" },
        { "refId": "C", "expr": "max(kafka_producer_request_latency_max{application=\"ingestion-api\"}) / 1000", "legendFormat": "request latency max" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Host load average (1 min) vs logical CPUs",
      "description": "Runnable threads on the host. Well above the CPU count means everything, including the Docker VM, waits for a CPU.",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(system_load_average_1m{application=\"ingestion-api\"})", "legendFormat": "load 1m" },
        { "refId": "B", "expr": "max(system_cpu_count{application=\"ingestion-api\"})", "legendFormat": "logical CPUs" }
      ]
    }
  ]
}
